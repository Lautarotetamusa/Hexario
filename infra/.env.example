# Copiá este archivo a infra/.env y completá los valores.
# infra/.env no se versiona.

# Imágenes publicadas por GitHub Actions en GHCR.
IMAGE_OWNER=lautarotetamusa
IMAGE_TAG=latest

# URL pública única. La landing vive en /, la PWA en /app/ y la API en /api/.
PUBLIC_URL=https://hexario.thorque.com.ar

# Postgres. Usá una password URL-safe (por ejemplo hex) porque el back arma
# DATABASE_URL con ella sin encodear.
DB_USER=hexario
DB_PASS=cambiame-por-un-hex-de-32
DB_NAME=hexario

# Auth. Generá ambos con: openssl rand -hex 32
JWT_SECRET=cambiame-por-un-hex-de-64
JWT_EXPIRES_IN=7d
