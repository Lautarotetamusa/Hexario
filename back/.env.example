# Copiá este archivo a back/.env y ajustá lo que necesites.
# `docker compose up` levanta Postgres con estos mismos valores por defecto.

# --- Base de datos (Postgres) ---
DB_HOST=localhost
DB_USER=hexario
DB_PASS=hexario
# Puerto del host. En docker compose, Postgres se publica acá y la API
# adentro del compose usa 5432 (ver docker-compose.yml).
DB_PORT=5433
DB_NAME=hexario

# --- Servidor ---
NODE_ENV=dev
PORT=3001
HOST=http://localhost:3001
# Puerto donde docker compose publica el front (sólo lo usa el compose).
APP_PORT=8080
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Auth ---
# Cambialo en cualquier entorno que no sea local.
JWT_SECRET=dev-only-change-me-9f3a7c1e5b8d2f4a6c0e7b9d1f3a5c8e
JWT_EXPIRES_IN=7d
