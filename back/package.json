{
    "dependencies": {
        "bcrypt": "^5.1.0",
        "bradb": "^3.1.6",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "drizzle-orm": "^0.44.7",
        "express": "^5.1.0",
        "h3-js": "^4.5.0",
        "jsonwebtoken": "^9.0.0",
        "pg": "^8.23.0",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@types/bcrypt": "^5.0.0",
        "@types/cors": "^2.8.13",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^6.0.2",
        "@vitest/coverage-v8": "^5.0.1",
        "drizzle-kit": "^0.31.11",
        "drizzle-zod": "^0.8.3",
        "eslint": "^9.9.0",
        "eslint-plugin-complexity": "^1.0.2",
        "eslint-plugin-sonarjs": "^4.2.1",
        "globals": "^15.9.0",
        "jscpd": "^5.3.2",
        "madge": "^8.0.0",
        "nodemon": "^3.0.3",
        "supertest": "^6.3.4",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.5",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.1",
        "vitest": "^5.0.1"
    },
    "name": "hexario-back",
    "type": "commonjs",
    "version": "1.0.0",
    "main": "src/index.ts",
    "keywords": [],
    "author": "Thorque Software",
    "license": "ISC",
    "description": "Backend base de Hexario (Express + Drizzle + Postgres): usuarios, auth JWT y arquitectura por módulos.",
    "scripts": {
        "dev": "nodemon src/index.ts",
        "dev:log": "mkdir -p logs && nodemon src/index.ts 2>&1 | tee -a logs/backend.log",
        "start:prod": "node dist/src/index.js",
        "build": "rm -rf ./dist/ && tsc && tsc-alias",
        "lint": "eslint src/",
        "lint:cycles": "madge --circular --extensions ts src",
        "lint:duplicates": "jscpd src --min-lines 4 --min-tokens 30",
        "docs:api": "node scripts/generate-api-docs.js",
        "test:setup": "./scripts/reset-test-db.sh",
        "test": "./scripts/reset-test-db.sh && NODE_ENV=dev DB_NAME=hexario_test npx vitest run",
        "test:coverage": "./scripts/reset-test-db.sh && NODE_ENV=dev DB_NAME=hexario_test npx vitest run --coverage",
        "seed": "ts-node seeders/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:run": "ts-node src/db/migrate.ts",
        "db:reset": "./db/reset.sh",
        "db:studio": "drizzle-kit studio"
    },
    "allowScripts": {
        "bcrypt@5.1.1": true,
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true
    }
}
