meta {
  name: List businesses
  type: http
  seq: 8
}

get {
  url: {{host}}/businesses
  body: none
  auth: none
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devuelve los negocios del seed", function () {
    expect(res.getBody().data.items).to.be.an("array");
    expect(res.getBody().data.items.length).to.be.greaterThan(0);
  });

  test("no expone el flag interno isActive", function () {
    expect(res.getBody().data.items[0].isActive).to.be.undefined;
  });
}

docs {
  # GET /businesses

  Lista los comercios activos. Es público: no requiere token.

  - **Auth:** no
  - **Éxito:** `200 OK`
  - **Respuesta:** `data.items` + `data.count`.

  ## Respuesta 200

      {
        "success": true,
        "data": {
          "count": 14,
          "items": [
            {
              "id": 1,
              "slug": "cafe-la-florida",
              "name": "Café La Florida",
              "description": "...",
              "category": "cafe",
              "address": "Córdoba 1234",
              "neighborhood": "Centro",
              "latitude": -32.9472,
              "longitude": -60.6392,
              "phone": "341 555 0101",
              "instagram": "cafelaflorida",
              "imageUrl": null
            }
          ]
        }
      }
}
