{
  "$description": "Hexario — design tokens (formato W3C Design Tokens / DTCG). Los temas claro y oscuro están en color.light y color.dark.",
  "color": {
    "light": {
      "ui": {
        "panel": { "$type": "color", "$value": "#FFFFFF" },
        "ink": { "$type": "color", "$value": "#0D110D" },
        "ink-2": { "$type": "color", "$value": "#6B706B", "$description": "Texto secundario, 5.1:1 sobre panel" },
        "ink-body": { "$type": "color", "$value": "#3E433E" },
        "line": { "$type": "color", "$value": "#E6E8E5" },
        "line-strong": { "$type": "color", "$value": "#D5D8D4" },
        "surface": { "$type": "color", "$value": "#F4F5F3" },
        "action": { "$type": "color", "$value": "#0D110D" },
        "on-action": { "$type": "color", "$value": "#FFFFFF" },
        "action-pressed": { "$type": "color", "$value": "#2B302B" },
        "disabled-bg": { "$type": "color", "$value": "#EDEFEC" },
        "disabled-ink": { "$type": "color", "$value": "#6B706B" }
      },
      "state": {
        "ok-bg": { "$type": "color", "$value": "#E4F7EA" },
        "ok-ink": { "$type": "color", "$value": "#14713A" },
        "alert-bg": { "$type": "color", "$value": "#FDECE9" },
        "alert-ink": { "$type": "color", "$value": "#B93A27" },
        "gold-bg": { "$type": "color", "$value": "#FFF4D6" },
        "gold-ink": { "$type": "color", "$value": "#8A5D10" }
      },
      "map": {
        "ground": { "$type": "color", "$value": "#F1F2F0" },
        "street": { "$type": "color", "$value": "#FFFFFF" },
        "water": { "$type": "color", "$value": "#DFE4E7" },
        "park": { "$type": "color", "$value": "#E7ECE5" },
        "grid": { "$type": "color", "$value": "#0D110D12", "$description": "Tinta al 7%" },
        "label": { "$type": "color", "$value": "#6B706B" }
      },
      "player": {
        "me": { "fill": { "$type": "color", "$value": "#5EE08A" }, "line": { "$type": "color", "$value": "#22B862" } },
        "sky": { "fill": { "$type": "color", "$value": "#9ADFFF" }, "line": { "$type": "color", "$value": "#2EA6E8" } },
        "coral": { "fill": { "$type": "color", "$value": "#FF8F80" }, "line": { "$type": "color", "$value": "#EC5A45" } },
        "violet": { "fill": { "$type": "color", "$value": "#8A5CF6" }, "line": { "$type": "color", "$value": "#6236D9" } },
        "neutral": { "fill": { "$type": "color", "$value": "#B9BEB8" }, "line": { "$type": "color", "$value": "#8E938E" } },
        "legendary": { "fill": { "$type": "color", "$value": "#FFD166" }, "line": { "$type": "color", "$value": "#E0A63A" }, "star": { "$type": "color", "$value": "#8A5D10" } }
      }
    },
    "dark": {
      "ui": {
        "panel": { "$type": "color", "$value": "#121512" },
        "ink": { "$type": "color", "$value": "#F2F5F1" },
        "ink-2": { "$type": "color", "$value": "#9AA19A", "$description": "7.0:1 sobre panel" },
        "ink-body": { "$type": "color", "$value": "#C9CEC8" },
        "line": { "$type": "color", "$value": "#262B26" },
        "line-strong": { "$type": "color", "$value": "#3A403A" },
        "surface": { "$type": "color", "$value": "#1B1F1B" },
        "action": { "$type": "color", "$value": "#F2F5F1" },
        "on-action": { "$type": "color", "$value": "#0D110D" },
        "action-pressed": { "$type": "color", "$value": "#DCE0DB" },
        "disabled-bg": { "$type": "color", "$value": "#1F231F" },
        "disabled-ink": { "$type": "color", "$value": "#8A918A" }
      },
      "state": {
        "ok-bg": { "$type": "color", "$value": "#163222" },
        "ok-ink": { "$type": "color", "$value": "#7BE3A0" },
        "alert-bg": { "$type": "color", "$value": "#3A1A15" },
        "alert-ink": { "$type": "color", "$value": "#FF9C8E" },
        "gold-bg": { "$type": "color", "$value": "#3A2E12" },
        "gold-ink": { "$type": "color", "$value": "#FFD166" }
      },
      "map": {
        "ground": { "$type": "color", "$value": "#171A17" },
        "street": { "$type": "color", "$value": "#222622" },
        "water": { "$type": "color", "$value": "#131B20" },
        "park": { "$type": "color", "$value": "#172017" },
        "grid": { "$type": "color", "$value": "#F2F5F112", "$description": "Tinta clara al 7%" },
        "label": { "$type": "color", "$value": "#9AA19A" }
      },
      "player": {
        "me": { "fill": { "$type": "color", "$value": "#5EE08A" }, "line": { "$type": "color", "$value": "#22B862" } },
        "sky": { "fill": { "$type": "color", "$value": "#9ADFFF" }, "line": { "$type": "color", "$value": "#2EA6E8" } },
        "coral": { "fill": { "$type": "color", "$value": "#FF8F80" }, "line": { "$type": "color", "$value": "#EC5A45" } },
        "violet": { "fill": { "$type": "color", "$value": "#8A5CF6" }, "line": { "$type": "color", "$value": "#9B74FF" } },
        "neutral": { "fill": { "$type": "color", "$value": "#6B706B" }, "line": { "$type": "color", "$value": "#8A918A" } },
        "legendary": { "fill": { "$type": "color", "$value": "#FFD166" }, "line": { "$type": "color", "$value": "#E0A63A" }, "star": { "$type": "color", "$value": "#FFD166" } }
      }
    }
  },
  "opacity": {
    "hex-me": { "$type": "number", "$value": 0.42 },
    "hex-rival": { "$type": "number", "$value": 0.26 },
    "hex-legendary": { "$type": "number", "$value": 0.34 },
    "hex-violet-dark": { "$type": "number", "$value": 0.34 },
    "hex-capture-start": { "$type": "number", "$value": 0.85 }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "monospace"] }
    }
  },
  "typography": {
    "num-hero": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "52px", "fontWeight": 500, "lineHeight": 1, "letterSpacing": "-0.04em" } },
    "num-data": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "22px", "fontWeight": 500, "lineHeight": 1.1, "letterSpacing": "-0.02em" } },
    "title": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "22px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "-0.015em" } },
    "subtitle": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0" } },
    "label": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0.12em" }, "$description": "Siempre en mayúsculas" },
    "label-sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "10px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.14em" }, "$description": "Siempre en mayúsculas" },
    "button": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.15, "letterSpacing": "0.08em" }, "$description": "Siempre en mayúsculas" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px", "$description": "Margen lateral de pantalla" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "pill": { "$type": "dimension", "$value": "999px" },
    "sheet": { "$type": "dimension", "$value": "22px" },
    "card": { "$type": "dimension", "$value": "14px" },
    "sm": { "$type": "dimension", "$value": "10px" }
  },
  "size": {
    "touch": { "$type": "dimension", "$value": "44px" },
    "button-primary": { "$type": "dimension", "$value": "56px" },
    "button-secondary": { "$type": "dimension", "$value": "48px" },
    "chip": { "$type": "dimension", "$value": "28px" },
    "nav": { "$type": "dimension", "$value": "64px" }
  },
  "shadow": {
    "light": {
      "float": { "$type": "shadow", "$value": [{ "color": "#0D110D0F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, { "color": "#0D110D14", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "0px" }] },
      "sheet": { "$type": "shadow", "$value": [{ "color": "#0D110D0A", "offsetX": "0px", "offsetY": "-2px", "blur": "6px", "spread": "0px" }, { "color": "#0D110D14", "offsetX": "0px", "offsetY": "-10px", "blur": "30px", "spread": "0px" }] }
    },
    "dark": {
      "float": { "$type": "shadow", "$value": { "color": "#00000080", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "0px" } },
      "sheet": { "$type": "shadow", "$value": { "color": "#00000080", "offsetX": "0px", "offsetY": "-10px", "blur": "30px", "spread": "0px" } }
    }
  },
  "duration": {
    "capture": { "$type": "duration", "$value": "900ms" },
    "pop": { "$type": "duration", "$value": "600ms" },
    "toast": { "$type": "duration", "$value": "3000ms" }
  }
}
